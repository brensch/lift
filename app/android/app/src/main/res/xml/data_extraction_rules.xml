<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The account files (getApplicationSupportDirectory,
     which is the app's files dir, then accounts/<user>.sqlite with its WAL
     and journal) are never backed up or moved to a new phone: the account
     comes from the server on sign-in, and a restored file could bring back
     a log the server no longer holds. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="accounts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="accounts/" />
    </device-transfer>
</data-extraction-rules>
