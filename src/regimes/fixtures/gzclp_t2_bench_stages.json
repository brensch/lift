{
  "regime": "gzclp",
  "description": "GZCLP T2 bench press — stage machine: 3×10 → 3×8 → 3×6 → reset with increment",
  "steps": [
    {
      "note": "Fresh start — T2 Stage 1: 3 sets × 10 reps. No AMRAP on T2.",
      "expect": [{ "exercise": "BenchPress", "weight": 45, "sets": 3, "reps": 10, "amrap": false }],
      "done":   [{ "exercise": "BenchPress", "weight": 45, "success": true,  "last_set_reps": 10 }]
    },
    {
      "note": "Success at Stage 1: +5 lbs (upper body increment), still Stage 1",
      "expect": [{ "exercise": "BenchPress", "weight": 50, "sets": 3, "reps": 10, "amrap": false }],
      "done":   [{ "exercise": "BenchPress", "weight": 50, "success": false, "last_set_reps": 7  }]
    },
    {
      "note": "Failure at Stage 1 → advance to Stage 2: now 3×8, hold weight at 50 lbs",
      "expect": [{ "exercise": "BenchPress", "weight": 50, "sets": 3, "reps": 8,  "amrap": false }],
      "done":   [{ "exercise": "BenchPress", "weight": 50, "success": false, "last_set_reps": 5  }]
    },
    {
      "note": "Failure at Stage 2 → advance to Stage 3: now 3×6, hold weight at 50 lbs",
      "expect": [{ "exercise": "BenchPress", "weight": 50, "sets": 3, "reps": 6,  "amrap": false }],
      "done":   [{ "exercise": "BenchPress", "weight": 50, "success": true,  "last_set_reps": 6  }]
    },
    {
      "note": "Success at Stage 3 → reset to Stage 1: +5 lbs, back to 3×10",
      "expect": [{ "exercise": "BenchPress", "weight": 55, "sets": 3, "reps": 10, "amrap": false }],
      "done":   []
    }
  ]
}
