{
  "regime": "gzclp",
  "description": "GZCLP full workout across 3 sessions — shows T1/T2/T3 working together and the T2 rotation recommending the least-recently-done exercises each session.",
  "config": {
    "days_per_week": 4,
    "exercises": ["Squat", "Deadlift", "BenchPress", "OverheadPress", "BarbellRow", "HipThrust", "BulgarianSplitSquat"]
  },
  "steps": [
    {
      "note": "Session 1 — fresh start. T1: both Squat+Deadlift are 5×3 AMRAP. T2 rotation: all exercises untrained, tiebreak by enum order puts BenchPress(2) and OverheadPress(4) first, so they're recommended over BarbellRow(5). T3 pair starts at default weight.",
      "expect": [
        { "exercise": "Squat",               "weight": 45,  "sets": 5, "reps": 3,  "amrap": true  },
        { "exercise": "Deadlift",             "weight": 135, "sets": 5, "reps": 3,  "amrap": true  },
        { "exercise": "BenchPress",           "weight": 45,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "OverheadPress",        "weight": 45,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "BarbellRow",           "weight": 65,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "HipThrust",            "weight": 45,  "sets": 3, "reps": 15 },
        { "exercise": "BulgarianSplitSquat",  "weight": 45,  "sets": 3, "reps": 15 }
      ],
      "expect_groups": [
        { "name": "Squat",                              "tags": ["recommended", "T1"] },
        { "name": "Deadlift",                           "tags": ["recommended", "T1"] },
        { "name": "Bench Press",                        "tags": ["recommended", "T2"] },
        { "name": "Overhead Press",                     "tags": ["recommended", "T2"] },
        { "name": "Barbell Row",                        "tags": ["T2"], "not_tags": ["recommended"] },
        { "name": "Hip Thrust + Bulgarian Split Squat", "tags": ["auxiliary", "T3"] }
      ],
      "done": [
        { "exercise": "Squat",              "weight": 45,  "success": true,  "last_set_reps": 4  },
        { "exercise": "Deadlift",           "weight": 135, "success": true,  "last_set_reps": 4  },
        { "exercise": "BenchPress",         "weight": 45,  "success": true,  "last_set_reps": 10 },
        { "exercise": "OverheadPress",      "weight": 45,  "success": true,  "last_set_reps": 10 },
        { "exercise": "HipThrust",          "weight": 45,  "success": true,  "last_set_reps": 18 },
        { "exercise": "BulgarianSplitSquat","weight": 45,  "success": true,  "last_set_reps": 20 }
      ]
    },
    {
      "note": "Session 2 — BarbellRow was never done (last_performed_at=0), so it's now the stalest T2. Of the two done at session 1, BenchPress(enum 2) sorts before OverheadPress(enum 4), so BarbellRow+BenchPress are recommended. OverheadPress is not. All weights progress from successes.",
      "expect": [
        { "exercise": "Squat",               "weight": 55,  "sets": 5, "reps": 3,  "amrap": true  },
        { "exercise": "Deadlift",            "weight": 145, "sets": 5, "reps": 3,  "amrap": true  },
        { "exercise": "BenchPress",          "weight": 50,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "OverheadPress",       "weight": 50,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "BarbellRow",          "weight": 65,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "HipThrust",           "weight": 45,  "sets": 3, "reps": 15 },
        { "exercise": "BulgarianSplitSquat", "weight": 45,  "sets": 3, "reps": 15 }
      ],
      "expect_groups": [
        { "name": "Squat",                              "tags": ["recommended", "T1"] },
        { "name": "Deadlift",                           "tags": ["recommended", "T1"] },
        { "name": "Barbell Row",                        "tags": ["recommended", "T2"] },
        { "name": "Bench Press",                        "tags": ["recommended", "T2"] },
        { "name": "Overhead Press",                     "tags": ["T2"], "not_tags": ["recommended"] },
        { "name": "Hip Thrust + Bulgarian Split Squat", "tags": ["auxiliary", "T3"] }
      ],
      "done": [
        { "exercise": "Squat",              "weight": 55,  "success": true,  "last_set_reps": 4  },
        { "exercise": "Deadlift",           "weight": 145, "success": true,  "last_set_reps": 4  },
        { "exercise": "BarbellRow",         "weight": 65,  "success": true,  "last_set_reps": 10 },
        { "exercise": "BenchPress",         "weight": 50,  "success": true,  "last_set_reps": 10 },
        { "exercise": "HipThrust",          "weight": 45,  "success": true,  "last_set_reps": 25 },
        { "exercise": "BulgarianSplitSquat","weight": 45,  "success": true,  "last_set_reps": 25 }
      ]
    },
    {
      "note": "Session 3 — OverheadPress last done session 1 (oldest T2). BenchPress and BarbellRow both done session 2, tiebreak by enum: BenchPress(2) < BarbellRow(5), so OverheadPress+BenchPress are recommended. BarbellRow is not. T3 AMRAP hit 25 last time → advance to 50 lbs.",
      "expect": [
        { "exercise": "Squat",               "weight": 65,  "sets": 5, "reps": 3,  "amrap": true  },
        { "exercise": "Deadlift",            "weight": 155, "sets": 5, "reps": 3,  "amrap": true  },
        { "exercise": "BenchPress",          "weight": 55,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "OverheadPress",       "weight": 50,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "BarbellRow",          "weight": 70,  "sets": 3, "reps": 10, "amrap": false },
        { "exercise": "HipThrust",           "weight": 50,  "sets": 3, "reps": 15 },
        { "exercise": "BulgarianSplitSquat", "weight": 50,  "sets": 3, "reps": 15 }
      ],
      "expect_groups": [
        { "name": "Squat",                              "tags": ["recommended", "T1"] },
        { "name": "Deadlift",                           "tags": ["recommended", "T1"] },
        { "name": "Overhead Press",                     "tags": ["recommended", "T2"] },
        { "name": "Bench Press",                        "tags": ["recommended", "T2"] },
        { "name": "Barbell Row",                        "tags": ["T2"], "not_tags": ["recommended"] },
        { "name": "Hip Thrust + Bulgarian Split Squat", "tags": ["auxiliary", "T3"] }
      ],
      "done": []
    }
  ]
}
