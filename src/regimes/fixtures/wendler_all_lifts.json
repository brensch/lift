{
  "regime": "wendler531",
  "description": "Wendler 5/3/1 — all 4 main lifts together, showing each exercise gets its own training max and percentages applied independently. Each step represents one full week (3 sessions done to advance week counter).",
  "config": {
    "days_per_week": 4,
    "exercises": ["Squat", "Deadlift", "BenchPress", "OverheadPress"],
    "one_rep_maxes": {
      "Squat":         200,
      "Deadlift":      200,
      "BenchPress":    140,
      "OverheadPress": 100
    }
  },
  "steps": [
    {
      "note": "Week 1 — Volume (5-rep sets). TMs: Squat/DL=180, Bench=126, OHP=90. Start at 65% TM each. Squat/DL: 180×0.65=117→115. Bench: 126×0.65=81.9→80. OHP: 90×0.65=58.5→60.",
      "expect": [
        { "exercise": "Squat",         "weight": 115, "sets": 3, "reps": 5, "amrap": true },
        { "exercise": "Deadlift",      "weight": 115, "sets": 3, "reps": 5, "amrap": true },
        { "exercise": "BenchPress",    "weight":  80, "sets": 3, "reps": 5, "amrap": true },
        { "exercise": "OverheadPress", "weight":  60, "sets": 3, "reps": 5, "amrap": true }
      ],
      "expect_groups": [
        { "name": "Squat",          "tags": ["recommended"] },
        { "name": "Deadlift",       "tags": ["recommended"] },
        { "name": "Bench Press",    "tags": ["recommended"] },
        { "name": "Overhead Press", "tags": ["recommended"] }
      ],
      "done": [
        { "exercise": "Squat", "weight": 115 },
        { "exercise": "Squat", "weight": 120 },
        { "exercise": "Squat", "weight": 125 }
      ]
    },
    {
      "note": "Week 2 — Intensity (3-rep sets). Start at 70% TM. Squat/DL: 180×0.70=126→125. Bench: 126×0.70=88.2→90. OHP: 90×0.70=63→65.",
      "expect": [
        { "exercise": "Squat",         "weight": 125, "sets": 3, "reps": 3, "amrap": true },
        { "exercise": "Deadlift",      "weight": 125, "sets": 3, "reps": 3, "amrap": true },
        { "exercise": "BenchPress",    "weight":  90, "sets": 3, "reps": 3, "amrap": true },
        { "exercise": "OverheadPress", "weight":  65, "sets": 3, "reps": 3, "amrap": true }
      ],
      "expect_groups": [
        { "name": "Squat",          "tags": ["recommended"] },
        { "name": "Deadlift",       "tags": ["recommended"] },
        { "name": "Bench Press",    "tags": ["recommended"] },
        { "name": "Overhead Press", "tags": ["recommended"] }
      ],
      "done": [
        { "exercise": "Squat", "weight": 125 },
        { "exercise": "Squat", "weight": 130 },
        { "exercise": "Squat", "weight": 135 }
      ]
    },
    {
      "note": "Week 3 — Peak (1-rep AMRAP). Start at 75% TM. Last set is AMRAP — push for max reps. Squat/DL: 180×0.75=135. Bench: 126×0.75=94.5→95. OHP: 90×0.75=67.5→70.",
      "expect": [
        { "exercise": "Squat",         "weight": 135, "sets": 3, "reps": 1, "amrap": true },
        { "exercise": "Deadlift",      "weight": 135, "sets": 3, "reps": 1, "amrap": true },
        { "exercise": "BenchPress",    "weight":  95, "sets": 3, "reps": 1, "amrap": true },
        { "exercise": "OverheadPress", "weight":  70, "sets": 3, "reps": 1, "amrap": true }
      ],
      "expect_groups": [
        { "name": "Squat",          "tags": ["recommended"] },
        { "name": "Deadlift",       "tags": ["recommended"] },
        { "name": "Bench Press",    "tags": ["recommended"] },
        { "name": "Overhead Press", "tags": ["recommended"] }
      ],
      "done": []
    }
  ]
}
