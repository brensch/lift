# Dev backend instance (dev.schlift.com). Runs alongside prod on the same box.
# PORT/DATA_DIR keep it isolated from the prod instance (50051, /opt/schlift).
# WebAuthn RP is the dev host, but the Android origins + cert fingerprint are the
# SAME as prod because the Play-delivered app is signed with the same key.
RUST_LOG=info
PORT=50052
DATA_DIR=data
WEBAUTHN_RP_ID=dev.schlift.com
WEBAUTHN_RP_ORIGIN=https://dev.schlift.com
WEBAUTHN_ANDROID_ORIGINS=android:apk-key-hash:oX5Jnmwq_UQ8_8dpupoKwQlGNOmMSUbcVSLLHh-lwsg,android:apk-key-hash:Hwxr_adafRh6rlMbMzDNEX8x9QWOBakh_yOw6HTCIew,android:apk-key-hash:kEDowpBvMt8rjVsbNoz919m3GjRFguoj8v4WJu0FYwA
ANDROID_CERT_SHA256=A1:7E:49:9E:6C:2A:FD:44:3C:FF:C7:69:BA:9A:0A:C1:09:46:34:E9:8C:49:46:DC:55:22:CB:1E:1F:A5:C2:C8
