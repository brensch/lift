RUST_LOG=warn
WEBAUTHN_RP_ID=schlift.com
WEBAUTHN_RP_ORIGIN=https://schlift.com
WEBAUTHN_ANDROID_ORIGINS=android:apk-key-hash:replace-me
# Optional: add local debug cert fingerprint if you need Android debug installs.
# ANDROID_CERT_SHA256=AA:BB:CC:...
# The apps' own TLS listener (src/tls.rs): phones connect to schlift.com:8443,
# past Caddy. The certificate is Caddy's, copied by schlift-tls-sync.
TLS_PORT=8443
TLS_CERT=/opt/schlift/shared/tls/schlift.com.crt
TLS_KEY=/opt/schlift/shared/tls/schlift.com.key
