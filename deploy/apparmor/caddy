# AppArmor profile for Caddy (TLS, the website, the gRPC-Web/@api proxy to the
# backends). A path-based layer on top of its systemd confinement. Caddy needs
# its config, its certificate store, the website roots it serves, and TCP.
#
# Roll out in complain mode first (`aa-complain`), watch for a few days of real
# traffic (journalctl -g 'apparmor.*DENIED'), add any missed paths, then
# `aa-enforce`. Installed to /etc/apparmor.d/caddy.
abi <abi/3.0>,
include <tunables/global>

profile caddy /usr/bin/caddy flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  capability net_bind_service,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  /usr/bin/caddy mr,
  /etc/caddy/ r,
  /etc/caddy/** r,
  # Its certificate store and state.
  /var/lib/caddy/ rw,
  /var/lib/caddy/** rwlk,
  /var/log/caddy/ rw,
  /var/log/caddy/** rwk,
  # The websites it serves (prod and dev), read-only.
  /opt/schlift/web/ r,
  /opt/schlift/web/** r,
  /opt/schlift-dev/web/ r,
  /opt/schlift-dev/web/** r,

  # systemd readiness/notify socket (Type=notify).
  /run/systemd/notify w,
  # The Go runtime reads its cgroup memory limit (GOMEMLIMIT) and machine id.
  /etc/machine-id r,
  @{sys}/fs/cgroup/** r,

  owner /proc/*/cgroup r,
  owner /proc/*/mountinfo r,
  owner /proc/*/mounts r,
  owner /proc/*/stat r,
  owner /proc/*/task/*/comm rw,

  deny /etc/shadow r,
}
