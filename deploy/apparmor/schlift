# AppArmor profile for the Schlift backend: a path-based mandatory-access layer
# on top of the systemd sandbox (ProtectSystem=strict, CapabilityBoundingSet=,
# ReadWritePaths, RestrictAddressFamilies). The binary only needs its own
# release dir, its environment's shared/ (data, env, certificates) and TCP.
#
# Covers both environments: prod (/opt/schlift) and dev (/opt/schlift-dev),
# each already confined to its own tree by its service user. Installed to
# /etc/apparmor.d/schlift and named by the units' AppArmorProfile=schlift.
#
# Roll out in complain mode first (`aa-complain`), watch `journalctl -g
# apparmor.*DENIED` for a few days of real traffic, add any missed paths, then
# `aa-enforce`.
abi <abi/3.0>,
include <tunables/global>

profile schlift /opt/schlift*/releases/*/schlift flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  network inet stream,
  network inet6 stream,

  # Its own binary (the symlinked release).
  /opt/schlift*/releases/*/schlift mr,
  # Its environment's state: data, env file, copied certificates.
  /opt/schlift*/shared/ r,
  /opt/schlift*/shared/** rwlk,

  # Reading its own process info; harmless system reads.
  owner /proc/*/stat r,
  owner /proc/*/task/*/comm rw,
  /sys/kernel/mm/transparent_hugepage/enabled r,

  # Deny everything else that matters, loudly.
  deny /etc/shadow r,
  deny /opt/schlift*/shared/** mx,
}
