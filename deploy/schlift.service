[Unit]
Description=Schlift backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__LIFT_USER__
Group=__LIFT_GROUP__
WorkingDirectory=__INSTALL_ROOT__/shared
EnvironmentFile=-__INSTALL_ROOT__/shared/schlift.env
ExecStart=__INSTALL_ROOT__/current/schlift
Restart=always
RestartSec=2
KillSignal=SIGTERM
# Stopping, the server writes every workout it holds (the phones would
# send them again, but a deploy should ack what it held): a busy server
# takes a minute or more.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
