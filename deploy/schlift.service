[Unit]
Description=Schlift backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__LIFT_USER__
Group=__LIFT_GROUP__
WorkingDirectory=__INSTALL_ROOT__/shared
EnvironmentFile=-__INSTALL_ROOT__/shared/schlift.env
ExecStart=__INSTALL_ROOT__/current/schlift
Restart=always
RestartSec=2
KillSignal=SIGTERM
# Stopping, the server writes what is due (workouts that ended, writes
# waited on) and checkpoints the WAL; workouts under way are left to the
# phones, which send them again. A busy end-of-workout burst takes a while.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
