schlift.com {
    encode zstd gzip

    # API + well-known routes → Rust backend
    handle /api/* {
        reverse_proxy 127.0.0.1:50051 {
            transport http {
                versions h2c 2
            }
        }
    }

    handle /.well-known/* {
        reverse_proxy 127.0.0.1:50051 {
            transport http {
                versions h2c 2
            }
        }
    }

    handle /apple-app-site-association {
        reverse_proxy 127.0.0.1:50051 {
            transport http {
                versions h2c 2
            }
        }
    }

    # gRPC-Web → Rust backend (all POST to /workout.v1.* service paths)
    @grpc {
        method POST
        path /workout.v1.*
    }
    handle @grpc {
        reverse_proxy 127.0.0.1:50051 {
            transport http {
                versions h2c 2
            }
        }
    }

    # Redirect old paths
    redir /forget /delete-account permanent

    # Everything else → static site with SPA fallback
    handle {
        root * /opt/schlift/web
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Dev backend: a second schlift instance on 127.0.0.1:50052 with its own DB and
# WebAuthn RP (dev.schlift.com). Mirrors the prod routes exactly, just a
# different upstream. The nightly dev app build points here via
# --dart-define=SERVER_HOST=dev.schlift.com. Auto-TLS works because *.schlift.com
# resolves to this box.
dev.schlift.com {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:50052 {
            transport http {
                versions h2c 2
            }
        }
    }

    handle /.well-known/* {
        reverse_proxy 127.0.0.1:50052 {
            transport http {
                versions h2c 2
            }
        }
    }

    handle /apple-app-site-association {
        reverse_proxy 127.0.0.1:50052 {
            transport http {
                versions h2c 2
            }
        }
    }

    @grpc {
        method POST
        path /workout.v1.*
    }
    handle @grpc {
        reverse_proxy 127.0.0.1:50052 {
            transport http {
                versions h2c 2
            }
        }
    }

    # Static site is shared with prod (harmless for a native-app dev host); the
    # app itself never hits these paths.
    handle {
        root * /opt/schlift/web
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
