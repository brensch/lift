# HTTP/1.1 and HTTP/2 only. HTTP/3 would bind UDP 443, which another
# service on this box (snek-server) holds; Caddy then fails to start and
# takes schlift.com down with it. The app speaks gRPC over HTTP/2 anyway.
{
    servers {
        protocols h1 h2
    }
}

# One definition of how every route reaches a backend, imported below as
# `import backend <upstream>`.
# While the backend restarts for a deploy, Caddy holds requests and retries the
# upstream (lb_try_duration) instead of answering 502: users see a short pause,
# not an error. flush_interval -1 passes each message on as it comes: the Sync
# stream stays open for a whole workout, and it costs nothing for plain requests.
(backend) {
    reverse_proxy {args[0]} {
        lb_try_duration 30s
        lb_try_interval 100ms
        flush_interval -1
        transport http {
            versions h2c 2
        }
    }
}

# What an app from before the apps' own listener is to be told when it
# calls the backend here, once the app that dials the listener is required: the phones' gRPC goes straight to the server's TLS listener
# (schlift.com:8443, src/tls.rs) now, so native gRPC on 443 is an app to
# update. Answered as the server's version gate answers (grpc-status 9,
# FAILED_PRECONDITION, app_update_required): a trailers-only response, which
# the app shows as its update prompt.
(update_required) {
    header Content-Type application/grpc
    header Grpc-Status 9
    header Grpc-Message app_update_required
    respond 200
}

schlift.com {
    encode zstd gzip

    # API + well-known routes → Rust backend
    handle /api/* {
        import backend 127.0.0.1:50051
    }

    handle /.well-known/* {
        import backend 127.0.0.1:50051
    }

    handle /apple-app-site-association {
        import backend 127.0.0.1:50051
    }

    # gRPC-Web (the website) → Rust backend
    @grpcweb {
        method POST
        path /workout.v1.*
        header Content-Type application/grpc-web*
    }
    handle @grpcweb {
        import backend 127.0.0.1:50051
    }

    # Native gRPC here is an app from before its own listener (0.22 and
    # older). Served until the app that dials the listener is the one the
    # stores give; then MIN_APP_VERSION goes up and this answers
    # `import update_required` instead (deploy/README.md).
    @grpc {
        method POST
        path /workout.v1.*
    }
    handle @grpc {
        import backend 127.0.0.1:50051
    }

    # Redirect old paths
    redir /forget /delete-account permanent

    # Everything else → static site with SPA fallback
    handle {
        root * /opt/schlift/web
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Only this site's own scripts, and calls to this server: the
        # session token is in localStorage, so a script injected or pulled in
        # from elsewhere would hold the account. Styles may be inline (React
        # style attributes) and the fonts are Google's.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }
}

# Dev backend: a second schlift instance on 127.0.0.1:50052 with its own DB and
# WebAuthn RP (dev.schlift.com). Mirrors the prod routes exactly, just a
# different upstream. The nightly dev app build points here via
# --dart-define=SERVER_HOST=dev.schlift.com. Auto-TLS works because *.schlift.com
# resolves to this box.
dev.schlift.com {
    encode zstd gzip

    handle /api/* {
        import backend 127.0.0.1:50052
    }

    handle /.well-known/* {
        import backend 127.0.0.1:50052
    }

    handle /apple-app-site-association {
        import backend 127.0.0.1:50052
    }

    # gRPC-Web (the website) → Rust backend
    @grpcweb {
        method POST
        path /workout.v1.*
        header Content-Type application/grpc-web*
    }
    handle @grpcweb {
        import backend 127.0.0.1:50052
    }

    # Native gRPC here is an app from before its own listener (0.22 and
    # older). Served until the app that dials the listener is the one the
    # stores give; then MIN_APP_VERSION goes up and this answers
    # `import update_required` instead (deploy/README.md).
    @grpc {
        method POST
        path /workout.v1.*
    }
    handle @grpc {
        import backend 127.0.0.1:50052
    }

    # The website built from the commit the dev backend runs
    # (scripts/deploy_schlift_dev.sh), so its pages talk to an API that has
    # their RPCs.
    handle {
        root * /opt/schlift-dev/web
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Only this site's own scripts, and calls to this server: the
        # session token is in localStorage, so a script injected or pulled in
        # from elsewhere would hold the account. Styles may be inline (React
        # style attributes) and the fonts are Google's.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }
}

# The other sites on this box (brensch.com, snek, ppp) install their own
# files here; the deploy replaces this Caddyfile, so it must import them or
# they go dark (it did, once).
import Caddyfile.d/*.caddyfile
