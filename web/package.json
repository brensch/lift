{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b",
    "test": "TZ=America/Los_Angeles node --test 'test/*.test.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.95.0",
    "prettier": "3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "yaml": "^2.9.1"
  }
}
